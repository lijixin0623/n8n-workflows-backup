    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11235/crawl_sync",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"urls\": \"{{ $json.profile_url }}\",\n  \"priority\": 10,\n  \"js_code\": [\n    \"async () => { for(let i=0; i<10; i++) { window.scrollTo(0, document.body.scrollHeight); await new Promise(r => setTimeout(r, 1500)); } }\"\n  ],\n  \"crawler_params\": {\n    \"headless\": true,\n    \"simulate_user\": false,\n    \"page_timeout\": 60000,\n    \"verbose\": true\n  },\n  \"extra_headers\": {\n    \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36\",\n    \"Cookie\": \"{{ $('Mock Data Input').item.json.cookie || '' }}\"\n  }\n}",
        "options": {}
      },
      "id": "79d85ab2-1745-40a6-9aa5-2adfd366441a",
      "name": "Crawl4ai Fetch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        368,
        32
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "CCfaiC92ZhZwdTHC",
          "name": "Crawl4ai Bearer Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const resultData = $input.item.json.result || {};\nconst htmlContent = resultData.html || '';\n\n// 扩大匹配范围：直接在整个 HTML 源码中搜索所有 18 到 20 位的抖音长数字 ID\nconst videoIdRegex = /\\b(7\\d{17,19})\\b/g;\nconst videoIds = new Set();\n\nlet match;\nwhile ((match = videoIdRegex.exec(htmlContent)) !== null) {\n  videoIds.add(match[1]);\n}\n\n// 转换为标准的抖音作品直链\nconst videoUrls = Array.from(videoIds).map(id => `https://www.douyin.com/video/${id}`);\n\nreturn [{\n  json: {\n    profile_url: resultData.url,\n    video_count: videoUrls.length,\n    video_urls: videoUrls,\n    extracted_at: new Date().toISOString()\n  }\n}];"
      },
