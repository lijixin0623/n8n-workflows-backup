      "parameters": {
        "jsCode": "// 获取上游输入\nconst items = $input.all();\n\n// 安全检查：防止上游无数据或 data.items 为空\nif (!items || items.length === 0 || !items[0].json || !items[0].json.data || !items[0].json.data.items) {\n  // 如果过去30天没有记录，直接返回空数组，让后续的去重逻辑跳过\n  return [];\n}\n\nconst list = items[0].json.data.items;\n\n// 正常映射历史记录\nreturn list.map(row => {\n  return {\n    json: {\n      title: row.fields[\"标题\"] ? row.fields[\"标题\"][0].text : \"\",\n      link: row.fields[\"原始链接\"] ? row.fields[\"原始链接\"].link : \"\"\n    }\n  };\n});"
