        "jsonBody": "={\n  \"file_name\": \"test.mp4\",\n  \"parent_type\": \"bitable_file\",\n  \"parent_node\": {{ $('设置应用凭证').item.json.app_token.toJsonString() }},\n  \"size\": {{ $json.size_in_bytes }}\n} ",
