        "respondWith": "text",
        "responseBody": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>南哥AGI研习社</title>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n            font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;\n        }\n        \n        body {\n            background: #0a0a16;\n            color: #fff;\n            min-height: 100vh;\n            overflow: hidden;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n        }\n        \n        #particles-js {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            z-index: -1;\n        }\n        \n        .container {\n            text-align: center;\n            z-index: 1;\n            max-width: 800px;\n            padding: 2rem;\n        }\n        \n        .logo {\n            width: 120px;\n            height: 120px;\n            margin: 0 auto 2rem;\n            background: linear-gradient(135deg, #00f7ff, #00d4ff);\n            border-radius: 50%;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            box-shadow: 0 0 30px rgba(0, 247, 255, 0.6);\n            animation: pulse 4s infinite alternate;\n        }\n        \n        .logo i {\n            font-size: 3.5rem;\n            color: #0a0a16;\n        }\n        \n        h1 {\n            font-size: 3.5rem;\n            margin-bottom: 1.5rem;\n            background: linear-gradient(90deg, #00f7ff, #00d4ff, #00a2ff);\n            -webkit-background-clip: text;\n            background-clip: text;\n            color: transparent;\n            text-shadow: 0 0 10px rgba(0, 247, 255, 0.5);\n            letter-spacing: 2px;\n        }\n        \n        .subtitle {\n            font-size: 1.5rem;\n            margin-bottom: 3rem;\n            color: #b3f0ff;\n            letter-spacing: 1px;\n        }\n        \n        .social-links {\n            display: flex;\n            justify-content: center;\n            gap: 2rem;\n            margin-top: 3rem;\n        }\n        \n        .social-link {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            text-decoration: none;\n            color: #b3f0ff;\n            transition: all 0.3s ease;\n            padding: 1rem;\n            border-radius: 10px;\n            width: 140px;\n        }\n        \n        .social-link:hover {\n            transform: translateY(-10px);\n            color: #00f7ff;\n            box-shadow: 0 10px 20px rgba(0, 247, 255, 0.2);\n            background: rgba(0, 247, 255, 0.1);\n        }\n        \n        .social-icon {\n            font-size: 2.5rem;\n            margin-bottom: 0.5rem;\n        }\n        \n        .social-text {\n            font-size: 1rem;\n            font-weight: 500;\n        }\n        \n        .bilibili {\n            color: #fb7299;\n        }\n        \n        .youtube {\n            color: #ff0000;\n        }\n        \n        .floating-text {\n            position: absolute;\n            bottom: 2rem;\n            width: 100%;\n            text-align: center;\n            color: rgba(179, 240, 255, 0.6);\n            font-size: 0.9rem;\n            letter-spacing: 1px;\n        }\n        \n        @keyframes pulse {\n            0% {\n                box-shadow: 0 0 20px rgba(0, 247, 255, 0.6);\n                transform: scale(1);\n            }\n            100% {\n                box-shadow: 0 0 40px rgba(0, 247, 255, 0.8);\n                transform: scale(1.05);\n            }\n        }\n        \n        @media (max-width: 768px) {\n            h1 {\n                font-size: 2.5rem;\n            }\n            \n            .subtitle {\n                font-size: 1.2rem;\n            }\n            \n            .social-links {\n                flex-direction: column;\n                align-items: center;\n                gap: 1rem;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div id=\"particles-js\"></div>\n    \n    <div class=\"container\">\n        <div class=\"logo\">\n            <i class=\"fas fa-robot\"></i>\n        </div>\n        \n        <h1>南哥AGI研习社</h1>\n        \n        <p class=\"subtitle\">分享AGI(通用人工智能)相关硬核知识</p>\n        \n        <div class=\"social-links\">\n            <a href=\"https://space.bilibili.com/509246474\" class=\"social-link bilibili\">\n                <i class=\"fab fa-bilibili social-icon\"></i>\n                <span class=\"social-text\">B站关注我</span>\n            </a>\n            \n            <a href=\"https://www.youtube.com/@南哥AGI研习社\" class=\"social-link youtube\">\n                <i class=\"fab fa-youtube social-icon\"></i>\n                <span class=\"social-text\">YouTube关注我</span>\n            </a>\n        </div>\n    </div>\n    \n    <div class=\"floating-text\">\n        分享AGI(通用人工智能)相关硬核知识\n    </div>\n\n    <script src=\"https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js\"></script>\n    <script>\n        particlesJS(\"particles-js\", {\n            particles: {\n                number: { value: 80, density: { enable: true, value_area: 800 } },\n                color: { value: \"#00f7ff\" },\n                shape: { type: \"circle\" },\n                opacity: { value: 0.5, random: true },\n                size: { value: 3, random: true },\n                line_linked: {\n                    enable: true,\n                    distance: 150,\n                    color: \"#00d4ff\",\n                    opacity: 0.4,\n                    width: 1\n                },\n                move: {\n                    enable: true,\n                    speed: 2,\n               