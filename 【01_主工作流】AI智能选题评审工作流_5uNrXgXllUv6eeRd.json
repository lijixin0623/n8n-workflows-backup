    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst list = items[0].json.data.items;\n\nreturn list.map(row => {\n  // 增加安全防护：如果字段为空，给个默认空字符串，防止报错\n  const sourceNameObj = row.fields['源名称'];\n  const sourceName = (sourceNameObj && sourceNameObj.length > 0) ? sourceNameObj[0].text : '';\n\n  const rssLinkObj = row.fields['RSS地址'];\n  const rssLink = rssLinkObj ? rssLinkObj.link : '';\n\n  return {\n    json: {\n      id: row.fields['源ID'],\n      source_name: sourceName,\n      source_link: rssLink,\n      source_type: row.fields['来源类型'],\n      record_id: row.record_id,\n    }\n  };\n});"
      },
