    {
      "parameters": {
        "jsCode": "// 获取AI分析结果和原始数据\nconst aiAnalysis = $input.first().json.output;\nconst originalData = $('接收POST请求').first().json.body;\n\n// 合并数据\nconst processedData = {\n  originalData,\n  aiAnalysis,\n  // 添加时间戳\n  received_at: new Date().toISOString(),\n  // 生成工单ID\n  ticket_id: 'T' + Date.now() + Math.random().toString(36).substr(2, 5)\n};\n\n// 决策逻辑\nlet action = 'normal';\n\nif (aiAnalysis.true_urgency === 'critical' || \n    aiAnalysis.sentiment === 'angry' ||\n    aiAnalysis.requires_immediate_human_intervention) {\n  action = 'urgent';\n} else if (aiAnalysis.category === 'general' && \n           aiAnalysis.true_urgency === 'low') {\n  action = 'auto_reply';\n}\n\nprocessedData.action_required = action;\n\n// 返回处理后的数据\nreturn [{ json: processedData }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        320
      ],
      "id": "20f74536-80b6-4858-a605-d0eab5b9fe17",
